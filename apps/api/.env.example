# =============================================================================
# Backend (FastAPI) — Environment Variables
# Copy to .env for backend local development or container deployment.
# =============================================================================

# Database (Neon PostgreSQL) — REQUIRED
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_CONNECT_TIMEOUT=5

# Database Connection Pool Tuning
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=300

# Application Environment
APP_ENV=production
LOG_LEVEL=INFO

# Authentication (Clerk)
CLERK_SECRET_KEY=

# AI Provider (Google Gemini)
GEMINI_API_KEY=

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://app.yourdomain.com

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage_data
MAX_UPLOAD_SIZE_MB=10

# Rate Limiting & Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=20
RATE_LIMIT_UPLOAD_REQUESTS_PER_MINUTE=30

# Observability
REQUEST_ID_HEADER_NAME=X-Request-ID
EXPOSE_ERROR_DETAILS=false
ANALYTICS_ENABLED=true
