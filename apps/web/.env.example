# =============================================================================
# Frontend (Next.js) — Environment Variables
# Copy to .env.local for local development.
# Set these in your frontend hosting environment (e.g. Vercel, Docker, Node.js).
# =============================================================================

# Public Backend API URL (Accessible from the user's browser)
# Normalizes automatically: http://localhost:8000, https://api.domain.com, or https://api.domain.com/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# Clerk Authentication Keys (From Clerk Dashboard)
# Public publishable key (exposed to browser for auth UI)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Server Secret Key (Server-only for Next.js middleware)
CLERK_SECRET_KEY=sk_test_...
