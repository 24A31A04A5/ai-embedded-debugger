# =============================================================================
# AI Embedded Debugging Platform — Master Environment Variables Template
# Copy this file to .env and fill in values.
# NEVER commit actual secrets or production .env files to version control.
# =============================================================================

# =============================================================================
# 1. BACKEND — SERVER-ONLY ENVIRONMENT VARIABLES (apps/api)
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL) — REQUIRED
# -----------------------------------------------------------------------------
# Accepts standard connection strings:
#   postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
#   postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require  (auto-normalized)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Database connection timeout in seconds (default: 5)
DATABASE_CONNECT_TIMEOUT=5

# Production connection pool tuning (QueuePool)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=300

# -----------------------------------------------------------------------------
# Application Environment & Logging
# -----------------------------------------------------------------------------
# Set to "production" in production environments.
# Disables /docs, /redoc, and /openapi.json, and enforces strict security.
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Authentication (Clerk — Backend Server-Only) — REQUIRED FOR AUTH
# -----------------------------------------------------------------------------
# From Clerk Dashboard -> API Keys -> Secret Key
CLERK_SECRET_KEY=

# -----------------------------------------------------------------------------
# AI Provider (Google Gemini) — REQUIRED FOR DEBUGGING & EMBEDDINGS
# -----------------------------------------------------------------------------
# From Google AI Studio
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# CORS Configuration (Production Security)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no wildcards in production)
# Example: https://ai-embedded-debugger.vercel.app,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Object Storage (Local filesystem or S3-compatible: AWS S3, Cloudflare R2, MinIO)
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage_data
MAX_UPLOAD_SIZE_MB=10

# When STORAGE_BACKEND=s3:
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=ai-embedded-debugger-files
# S3_REGION=auto

# -----------------------------------------------------------------------------
# Abuse Protection & Rate Limits
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=20
RATE_LIMIT_UPLOAD_REQUESTS_PER_MINUTE=30

MAX_FILES_PER_PROJECT=50
MAX_DOCUMENTS_PER_PROJECT=20
MAX_DOCUMENT_PAGES=500
MAX_CHUNKS_PER_DOCUMENT=1000

# -----------------------------------------------------------------------------
# Observability & Monitoring
# -----------------------------------------------------------------------------
REQUEST_ID_HEADER_NAME=X-Request-ID
EXPOSE_ERROR_DETAILS=false
ANALYTICS_ENABLED=true

# =============================================================================
# 2. FRONTEND — CLIENT & SERVER ENVIRONMENT VARIABLES (apps/web)
# =============================================================================

# Frontend Public API URL (Accessible from user browser)
# Normalizes automatically with or without /v1 and with or without trailing slash
# Example: https://api.yourdomain.com/v1 or http://localhost:8000/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# Clerk Public Publishable Key (Public - exposed to browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk Secret Key (Server-only for Next.js middleware)
CLERK_SECRET_KEY=

# =============================================================================
# 3. TESTING
# =============================================================================
# Set to 1 to run live PostgreSQL integration tests against DATABASE_URL
RUN_DATABASE_INTEGRATION_TESTS=0
