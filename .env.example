# =============================================================================
# AI Embedded Debugging Platform — Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL — Neon (hosted development database)
# -----------------------------------------------------------------------------
# 1. Create a free project at https://neon.tech
# 2. Create a database (PostgreSQL 16) and copy the connection string
# 3. Use the psycopg driver form shown below (not postgres://)
# 4. Neon requires SSL; append ?sslmode=require if it is not already present
#
# Example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Fail fast when Neon is unreachable (seconds)
DATABASE_CONNECT_TIMEOUT=5

# -----------------------------------------------------------------------------
# Object Storage (deferred — required when file uploads are implemented)
# -----------------------------------------------------------------------------
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=

# -----------------------------------------------------------------------------
# Authentication (Phase 1)
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# AI Provider (Phase 3 — not used in Phase 0)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Frontend (Phase 1 — not used in Phase 0)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Tests
# -----------------------------------------------------------------------------
# Set to 1 to run live PostgreSQL integration tests against DATABASE_URL
# RUN_DATABASE_INTEGRATION_TESTS=0
