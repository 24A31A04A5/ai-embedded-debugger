{
  "name": "ai-embedded-debugger",
  "private": true,
  "scripts": {
    "lint": "pnpm --filter @ai-embedded-debugger/web lint",
    "typecheck": "pnpm --filter @ai-embedded-debugger/web typecheck",
    "build:web": "pnpm --filter @ai-embedded-debugger/web build",
    "start:web": "pnpm --filter @ai-embedded-debugger/web start",
    "lint:api": "ruff check apps/api && ruff format --check apps/api",
    "typecheck:api": "mypy apps/api",
    "test:api": "pytest apps/api/tests",
    "start:api": "uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port 8000",
    "migrate": "alembic -c db/alembic.ini upgrade head"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
